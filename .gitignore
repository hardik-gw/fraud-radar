# --- Environment ---
.venv/
__pycache__/
*.py[cod]
.python-version.local

# --- Credentials: never commit these ---
.env
*.env
kaggle.json
**/kaggle.json
*.pem

# --- Data: too large for git, and not source code ---
# Fetch instructions live in the README.
# Note: git cannot re-include a file inside an excluded *directory*, so we
# exclude directory *contents* (data/raw/*) and then re-include the .gitkeep.
data/*
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Model artifacts: regenerated by the training notebook ---
models/*
!models/.gitkeep
!models/metrics.json
*.pkl
*.joblib
*.pt
*.h5

# --- Notebooks ---
.ipynb_checkpoints/

# --- Tooling / OS ---
.pytest_cache/
.ruff_cache/
.DS_Store
